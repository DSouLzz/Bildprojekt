{
  "name":"mitt-bild-projekt",
  "version":"0.4.0",
  "description":"Mitt bild projekt - AI-bildeditor",
  "main":"electron/main.cjs",
  "private":true,
  "type":"module",
  "scripts":{
    "dev":"vite",
    "build":"vite build",
    "preview":"vite preview",
    "desktop":"electron .",
    "dist":"npm run build && electron-builder",
    "release":"npm run build && electron-builder --publish onTag"
  },
  "dependencies":{
    "lucide-react":"^0.468.0",
    "react":"^18.3.1",
    "react-dom":"^18.3.1"
  },
  "devDependencies":{
    "@vitejs/plugin-react":"^4.3.4",
    "electron":"^36.0.0",
    "electron-builder":"^26.0.12",
    "electron-updater":"^6.6.2",
    "vite":"^6.0.5"
  },
  "build":{
    "appId":"se.mittbildprojekt.app",
    "productName":"Mitt bild projekt",
    "asar":true,
    "files":["dist/**/*","electron/**/*","package.json"],
    "publish":[{"provider":"github","owner":"DSouLzz","repo":"Bildprojekt","releaseType":"release"}],
    "win":{"target":["nsis"],"artifactName":"Mitt-bild-projekt-Setup-${version}.${ext}"},
    "mac":{"target":["dmg","zip"]},
    "linux":{"target":["AppImage"]}
  }
}
